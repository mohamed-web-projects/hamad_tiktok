# ============================================================
# Hamad TikTok — environment
# انسخ الملف ده لـ .env واملأ القيم
#   cp .env.example .env
# ============================================================

# من لوحة developers.tiktok.com → App → Credentials
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# لازم يطابق حرف بحرف الـ Redirect URI المسجّل عند تيك توك
# محليًا:  http://localhost:8899/auth/tiktok/callback
# على Render: https://<service-name>.onrender.com/auth/tiktok/callback
TIKTOK_REDIRECT_URI=http://localhost:8899/auth/tiktok/callback

# الصلاحيات المطلوبة (مفصولة بفاصلة، من غير مسافات)
TIKTOK_SCOPES=user.info.basic,user.info.profile,user.info.stats,video.publish

# سر توقيع الجلسات — سلسلة عشوائية طويلة
SESSION_SECRET=

# اختياري: يثبّت الـ Site URL في صفحة التفعيل
# SITE_URL=https://hamad-tiktok.onrender.com

# اختياري: المنفذ (الاستضافة بتحدده تلقائيًا)
# PORT=8899

{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    { "source": "/(.*)", "destination": "/api/index.js" }
  ],
  "functions": {
    "api/index.js": {
      "includeFiles": "{views,public}/**/*",
      "maxDuration": 10
    },
    "server.js": {
      "includeFiles": "{views,public}/**/*",
      "maxDuration": 10
    }
  }
}
